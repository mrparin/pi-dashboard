MQTT_HOST=sci-iot.ddns.net
MQTT_PORT=1883
MQTT_TOPIC=durian_farm1/node_sensor
MQTT_QOS=1

DB_PATH=./data/durian_dashboard.db
RETAIN_DAYS=90

APP_HOST=127.0.0.1
APP_PORT=8000
REFRESH_SECONDS=3
FRONTEND_ORIGINS=http://localhost:3001

# Thai Meteorological Department NWP API
TMD_ACCESS_TOKEN=

# Station metadata for FAO-56 hourly ET0. Set the real field coordinates.
STATION_LATITUDE=
STATION_LONGITUDE=
STATION_ALTITUDE_M=0
STATION_TIMEZONE=Asia/Bangkok
WIND_SENSOR_HEIGHT_M=2

# Calibrate this conversion against a pyranometer when possible.
LUX_PER_WM2=120

# Do not estimate ET0 across longer data gaps.
ETO_MAX_GAP_MINUTES=60
